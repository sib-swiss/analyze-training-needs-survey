	number = {1},
	urldate = {2026-07-17},
	journal = {Bioinformatics Advances},
	author = {Velozo, Bernardo and Carvalho, Clara and Feitosa, Rayssa and Leal Pedroza, Lucas Aleixo and Danzer, Emerson and Alves, Sandy Ingrid Aguiar and Neves, Maira and Fam, Bibiana},
	editor = {Mulder, Nicola},
	month = dec,
	year = {2024},
